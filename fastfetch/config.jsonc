{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "right": 6, "top": 1 }
    },
    "display": { "separator": "" },
    "modules": [
                {
            "type": "title",
            "format": "                     {user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────────────────────────"
        },
        {
            "type": "custom",
            "format": " ╭─────────╮"
        },
        { "type": "os",       "key": " │   os    │   ", "keyWidth": 15 },
        { "type": "host",     "key": " │  host   │   ", "keyWidth": 15 },
        { "type": "uptime",   "key": " │   up    │   ", "keyWidth": 15 },
        { "type": "packages", "key": " │  pkgs   │   ", "keyWidth": 15 },
        { "type": "shell",    "key": " │  shell  │   ", "keyWidth": 15 },
        { "type": "display",  "key": " │   res   │   ", "keyWidth": 15 },
        {
            "type": "custom",
            "format": " ├─────────┤"
        },
        { "type": "cpu",     "key": " │   cpu   │   ", "keyWidth": 15 },
        { "type": "gpu",     "key": " │   gpu   │   ", "keyWidth": 15 },
        { "type": "memory",  "key": " │   ram   │   ", "keyWidth": 15 },
        { "type": "disk",    "key": " │  disk   │   ", "keyWidth": 15, "folders": "/" },
        { "type": "disk",    "key": " │   win   │   ", "keyWidth": 15, "folders": "/win" },
        {
            "type": "custom",
            "format": " ╰─────────╯"
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────────────────────────"
        },

        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
