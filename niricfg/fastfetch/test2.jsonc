{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        { "type": "os",     "key": "  os    " },
        { "type": "kernel", "key": "  kernel" },
        { "type": "cpu",    "key": "  cpu   " },
        { "type": "gpu",    "key": "  gpu   " },
        { "type": "memory", "key": "  ram   " },
        "separator",
        "colors"
    ]
}
