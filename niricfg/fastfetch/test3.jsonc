{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "cyan",
            "2": "blue"
        },
        "padding": {
            "right": 4,
            "top": 1
        }
    },
    "display": {
        "separator": " · ",
        "color": {
            "keys": "cyan",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os",     "key": "os    " },
        { "type": "kernel", "key": "kernel" },
        { "type": "cpu",    "key": "cpu   " },
        { "type": "gpu",    "key": "gpu   " },
        { "type": "memory", "key": "ram   " },
        "separator",
        "colors"
    ]
}
